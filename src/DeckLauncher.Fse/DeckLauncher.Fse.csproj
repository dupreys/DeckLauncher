<Project Sdk="Microsoft.NET.Sdk">

  <!-- A ponte do Modo Xbox: um programinha .NET Framework 4.8 (já vem no Windows 11) que abre o DeckLauncher.
       Fica fora da solução principal de propósito: é compilada só pelo fluxo de release (fse/Build-Fse.ps1). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>DeckLauncherFSE</AssemblyName>
    <RootNamespace>DeckLauncher.Fse</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>

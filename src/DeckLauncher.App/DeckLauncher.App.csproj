<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>DeckLauncher.App</RootNamespace>
    <AssemblyName>DeckLauncher</AssemblyName>
    <Version>1.0.0</Version>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\Sounds\*.wav" />
    <!-- Optional store logos (Lojas page): drop store-steam.png / store-epic.png here and they ship next to the program. -->
    <None Include="Assets\store-*.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Draws the Steam chat sign-in QR code (MIT licence). -->
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <!-- Talks to Steam like the Steam client does (chat messages). MIT licence. -->
    <PackageReference Include="SteamKit2" Version="3.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LiteLauncher.Core\LiteLauncher.Core.csproj" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>DeckLauncher.App</RootNamespace>
    <AssemblyName>DeckLauncher</AssemblyName>
    <Version>1.5.1</Version>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\Sounds\*.wav" />
    <!-- Optional store logos (Lojas page): drop store-steam.png / store-epic.png here and they ship next to the program. -->
    <None Include="Assets\store-*.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DeckLauncher.Core\DeckLauncher.Core.csproj" />
  </ItemGroup>

</Project>

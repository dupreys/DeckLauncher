                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource TextMuted}" Margin="0,3,0,12"
                                           Text="Gratuita. Serve para mostrar seus amigos, o que eles estão jogando e a atividade (abas Amigos e Novidades). Seu perfil e a lista de amigos precisam estar públicos. Fica salva só neste PC (criptografada) e é enviada apenas à Steam."/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBox x:Name="SteamKeyBox" Width="420" FontSize="16" Padding="8,7" Background="{DynamicResource Panel}" Foreground="White"
                                             BorderBrush="{DynamicResource Focus}" CaretBrush="White" TextChanged="OnSteamKeyChanged"/>
                                    <Button Style="{StaticResource TabText}" Content="OBTER CHAVE" Margin="10,0,0,0" Click="OnGetSteamKeyClick"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="SetGames" Visibility="Collapsed">
                        <TextBlock Text="Jogos adicionados" FontSize="32" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock TextWrapping="Wrap" FontSize="14" Foreground="{StaticResource TextMuted}" Margin="0,0,0,18"
                                   Text="Jogos de fora da Steam e da Epic. Escolha o arquivo .exe do jogo; o launcher o inicia direto."/>
                        <Button Style="{StaticResource TabText}" Content="+ ADICIONAR JOGO" HorizontalAlignment="Left" Margin="0,0,0,16" Click="OnAddGameClick"/>
                        <StackPanel x:Name="ManualList"/>
                        <TextBlock Text="Jogos escondidos" FontSize="24" FontWeight="SemiBold" Margin="0,34,0,8"/>
                        <TextBlock TextWrapping="Wrap" FontSize="14" Foreground="{StaticResource TextMuted}" Margin="0,0,0,14"
                                   Text="Jogos que você escondeu das listas. Eles continuam instalados; use MOSTRAR para trazê-los de volta."/>
                        <StackPanel x:Name="HiddenList"/>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- Novidades / Amigos / Recomendados -->
        <Grid x:Name="FeedPage" Margin="0,56,0,56" Visibility="Collapsed" Background="{DynamicResource Bg}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Margin="54,10,54,0">
                <Border HorizontalAlignment="Left" VerticalAlignment="Center" Background="White" CornerRadius="14" Padding="12,3">
                    <TextBlock Text="LB" Foreground="Black" FontWeight="Bold" FontSize="14"/>
                </Border>
                <StackPanel x:Name="FeedTabs" Orientation="Horizontal" HorizontalAlignment="Center">
                    <RadioButton x:Name="FeedTabNews" Style="{StaticResource LibTab}" GroupName="FeedTabs" Tag="news" Content="NOVIDADES" Checked="OnFeedTabChecked"/>
                    <RadioButton x:Name="FeedTabFriends" Style="{StaticResource LibTab}" GroupName="FeedTabs" Tag="friends" Content="AMIGOS" Checked="OnFeedTabChecked"/>
                    <RadioButton x:Name="FeedTabRecs" Style="{StaticResource LibTab}" GroupName="FeedTabs" Tag="recs" Content="RECOMENDADOS" Checked="OnFeedTabChecked"/>
                </StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="White" CornerRadius="14" Padding="12,3">
                    <TextBlock Text="RB" Foreground="Black" FontWeight="Bold" FontSize="14"/>
                </Border>
            </Grid>
            <ScrollViewer x:Name="FeedScroll" Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <StackPanel x:Name="FeedContent" Margin="54,14,0,40"/>
            </ScrollViewer>
        </Grid>

        <Grid x:Name="OtherPage" Margin="0,56,0,56" Visibility="Collapsed">
            <TextBlock x:Name="OtherTitle" FontSize="34" FontWeight="SemiBold" Margin="46,24,0,0"/>
            <TextBlock Text="Em construção nas próximas etapas." Foreground="{StaticResource TextMuted}" FontSize="16" Margin="46,80,0,0"/>
        </Grid>

        <Grid x:Name="StoresPage" Margin="0,56,0,56" Visibility="Collapsed">
            <StackPanel Margin="54,24,54,0">
                <TextBlock Text="Lojas" FontSize="34" FontWeight="SemiBold"/>
                <TextBlock Text="Escolha onde comprar e baixar jogos." FontSize="14" Foreground="{StaticResource TextMuted}" Margin="2,4,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,30,0,0">
                    <Button x:Name="StoreSteamButton" Style="{StaticResource MediaTile}" Tag="steam" Click="OnStoreClick" Margin="2,0,28,0" AutomationProperties.Name="Steam">
                        <Grid>
                            <!-- Own drawing: steam rising from a bowl. Drop Assets\store-steam.png next to the program to use a logo instead. -->
                            <Viewbox x:Name="SteamIcon" Width="120" Height="120" Stretch="Uniform">
                                <Canvas Width="120" Height="120">
                                    <Path Stroke="White" StrokeThickness="7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Data="M36,70 C26,58 46,46 36,34 C26,22 46,10 36,2 M60,70 C50,58 70,46 60,34 C50,22 70,10 60,2 M84,70 C74,58 94,46 84,34 C74,22 94,10 84,2"/>
                                    <Path Fill="White" Data="M16,82 L104,82 C104,106 86,118 60,118 C34,118 16,106 16,82 Z"/>
                                </Canvas>
                            </Viewbox>
                            <Image x:Name="SteamLogo" Visibility="Collapsed" Margin="44" Stretch="Uniform"/>
                            <TextBlock x:Name="SteamLabel" Text="Steam" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextSoft}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,12"/>
                        </Grid>
                    </Button>
                    <Button x:Name="StoreEpicButton" Style="{StaticResource MediaTile}" Tag="epic" Click="OnStoreClick" Margin="0,0,24,0" AutomationProperties.Name="Epic Games">
                        <Grid>
                            <!-- Own drawing: a bolt on a rounded badge. Drop Assets\store-epic.png next to the program to use a logo instead. -->
                            <Viewbox x:Name="EpicIcon" Width="120" Height="120" Stretch="Uniform">
                                <Canvas Width="120" Height="120">
                                    <Rectangle Width="120" Height="120" RadiusX="22" RadiusY="22" Fill="White"/>
                                    <Path Fill="{DynamicResource T_171D26}" Data="M66,10 L24,68 L54,68 L44,112 L96,50 L66,50 Z"/>
                                </Canvas>
                            </Viewbox>
                            <Image x:Name="EpicLogo" Visibility="Collapsed" Margin="44" Stretch="Uniform"/>
                            <TextBlock x:Name="EpicLabel" Text="Epic Games" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextSoft}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,12"/>
                        </Grid>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>

        <Grid x:Name="MediaPage" Margin="0,56,0,56" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Margin="54,24,54,0">
                <TextBlock Text="Mídias" FontSize="34" FontWeight="SemiBold"/>
                <TextBlock x:Name="MediaSubtitle" FontSize="14" Foreground="{StaticResource TextMuted}" Margin="2,4,0,0"/>
            </StackPanel>
            <TextBlock x:Name="MediaEmpty" Grid.Row="1" Visibility="Collapsed" FontSize="17" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"
                       MaxWidth="760" HorizontalAlignment="Left" Margin="56,30,0,0"/>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" Focusable="False">
                <WrapPanel x:Name="MediaGrid" Margin="54,22,30,30"/>
            </ScrollViewer>
        </Grid>

        <!-- Manage art: pick covers, backgrounds, logos and screenshots -->
        <Grid x:Name="ManagePanel" Visibility="Collapsed" Margin="0,56,0,56" Background="{DynamicResource Bg}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Margin="54,20,54,0">
                <TextBlock Text="GERENCIAR ARTE" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Accent}"/>
                <TextBlock x:Name="ManageGameName" FontSize="30" FontWeight="SemiBold" Margin="0,4,0,14" TextTrimming="CharacterEllipsis"/>
                <WrapPanel x:Name="ManageTabs">
                    <RadioButton x:Name="ManageTabCover" Style="{StaticResource LibTab}" GroupName="ManageTabs" Tag="Cover" Content="CAPAS" Checked="OnManageTabChecked"/>
                    <RadioButton Style="{StaticResource LibTab}" GroupName="ManageTabs" Tag="Background" Content="FUNDOS" Checked="OnManageTabChecked"/>
                    <RadioButton Style="{StaticResource LibTab}" GroupName="ManageTabs" Tag="Wallhaven" Content="FUNDOS 16:9" Checked="OnManageTabChecked"/>
                    <RadioButton Style="{StaticResource LibTab}" GroupName="ManageTabs" Tag="Logo" Content="LOGOTIPOS" Checked="OnManageTabChecked"/>
                    <RadioButton Style="{StaticResource LibTab}" GroupName="ManageTabs" Tag="Shots" Content="CAPTURAS" Checked="OnManageTabChecked"/>
                    <Button Style="{StaticResource TabText}" Content="RESTAURAR PADRÃO" Margin="14,0,0,0" Click="OnManageResetClick"/>
                    <Button Style="{StaticResource TabText}" Content="VOLTAR" Click="OnManageBackClick"/>
                </WrapPanel>
                <StackPanel x:Name="KeyRow" Orientation="Horizontal" Margin="0,16,0,0" Visibility="Collapsed">
                    <TextBlock Text="Chave da API do SteamGridDB:" FontSize="15" VerticalAlignment="Center" Foreground="{StaticResource TextSoft}" Margin="0,0,14,0"/>
                    <TextBox x:Name="KeyBox" Width="380" FontSize="15" Padding="8,6" Background="{DynamicResource Panel}" Foreground="White"
                             BorderBrush="{DynamicResource Focus}" CaretBrush="White"/>
                    <Button Style="{StaticResource TabText}" Content="SALVAR" Margin="10,0,0,0" Click="OnSaveKeyClick"/>
                    <Button Style="{StaticResource TabText}" Content="OBTER CHAVE" Click="OnGetKeyClick"/>
                </StackPanel>
                <TextBlock x:Name="ManageStatus" Margin="0,16,0,12" FontSize="14" TextWrapping="Wrap" Foreground="{StaticResource TextMuted}"/>
            </StackPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" Focusable="False">
                <WrapPanel x:Name="ManageResults" Margin="54,4,54,30"/>
            </ScrollViewer>
        </Grid>

        <!-- Top bar: search, notifications, language, clock, avatar -->
        <Grid VerticalAlignment="Top" Height="56">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#99000000" Offset="0"/>
                    <GradientStop Color="#00000000" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>
            <Grid x:Name="SearchHost" Visibility="Collapsed" HorizontalAlignment="Left" Margin="24,0,0,0" Width="420">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" Margin="0,0,14,0"/>
                    <Grid Width="360" VerticalAlignment="Center">
                        <TextBlock x:Name="SearchHint" Text="Busque jogos..." FontSize="18" FontStyle="Italic" Foreground="{StaticResource TextMuted}" IsHitTestVisible="False"/>
                        <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" FontSize="18" Foreground="{StaticResource Text}"
                                 CaretBrush="{StaticResource Text}" TextChanged="OnSearchChanged"/>
                    </Grid>
                </StackPanel>
            </Grid>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,24,0">
                <Button Style="{StaticResource TopIcon}" Click="OnTopSearchClick" ToolTip="Buscar jogos"><TextBlock Text="&#xE721;" Style="{StaticResource Icon}"/></Button>
                <Button x:Name="BellButton" Style="{StaticResource TopIcon}" Click="OnTopDownloadsClick" ToolTip="Notificações e downloads">
                    <Grid>
                        <TextBlock Text="&#xEA8F;" Style="{StaticResource Icon}"/>
                        <Border x:Name="BellBadge" Visibility="Collapsed" Background="{DynamicResource Accent}" CornerRadius="9" MinWidth="18" Height="18" Padding="4,0"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-12,-14,0" IsHitTestVisible="False">
                            <TextBlock x:Name="BellBadgeText" FontSize="11" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Button>
                <Button x:Name="NetButton" Style="{StaticResource TopIcon}" Click="OnTopNetworkClick" ToolTip="Conexão"><TextBlock x:Name="NetIcon" Text="&#xE774;" Style="{StaticResource Icon}"/></Button>
                <Button x:Name="VolButton" Style="{StaticResource TopIcon}" Click="OnTopVolumeClick" ToolTip="Som"><TextBlock x:Name="VolIcon" Text="&#xE767;" Style="{StaticResource Icon}"/></Button>
                <TextBlock x:Name="Clock" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,24,0"/>
                <Button x:Name="ProfileButton" Style="{StaticResource AvatarButton}" Click="OnProfileClick" ToolTip="Perfil">
                    <Grid>
                        <TextBlock x:Name="AvatarGlyph" Text="&#xE77B;" Style="{StaticResource Icon}" FontSize="26" Foreground="{StaticResource TextMuted}"/>
                        <Image x:Name="AvatarImage" Stretch="UniformToFill"/>
                    </Grid>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Bottom bar: menu on the left, hints on the right -->
        <Grid VerticalAlignment="Bottom" Height="56" Background="{DynamicResource T_E6080C11}">
            <StackPanel Orientation="Horizontal" Margin="44,0,0,0" VerticalAlignment="Center">
                <Border x:Name="MenuChip" Style="{StaticResource KeyChip}"><TextBlock x:Name="MenuChipText" Text="F1" Foreground="Black" FontWeight="Bold" FontSize="14"/></Border>
                <TextBlock Text="MENU" FontWeight="Bold" FontSize="15" Margin="14,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,44,0" VerticalAlignment="Center">
                <StackPanel x:Name="HintExtras" Orientation="Horizontal"/>
                <Border x:Name="SelectChip" Style="{StaticResource KeyChip}"><TextBlock x:Name="SelectChipText" Text="Enter" Foreground="Black" FontWeight="Bold" FontSize="14"/></Border>
                <TextBlock x:Name="SelectLabel" Text="SELECIONAR" FontWeight="Bold" FontSize="15" Margin="14,0,34,0" VerticalAlignment="Center"/>
                <Border x:Name="BackChip" Style="{StaticResource KeyChip}"><TextBlock x:Name="BackChipText" Text="Esc" Foreground="Black" FontWeight="Bold" FontSize="14"/></Border>
                <TextBlock Text="VOLTAR" FontWeight="Bold" FontSize="15" Margin="14,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <Border x:Name="Toast" Visibility="Collapsed" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,84"
                Background="{DynamicResource T_EE232A34}" Padding="26,14" CornerRadius="6">
            <TextBlock x:Name="ToastText" FontSize="16"/>
        </Border>

        <!-- Quick panels under the top bar: connections and sound -->
        <Grid x:Name="QuickLayer" Visibility="Collapsed">
            <Rectangle Fill="#01000000" MouseDown="OnQuickDimClick"/>
            <Border x:Name="NetPanel" Visibility="Collapsed" Width="400" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,60,24,0"
                    Background="{DynamicResource T_F2171D26}" Padding="26" KeyboardNavigation.DirectionalNavigation="Contained">
                <StackPanel>
                    <TextBlock Text="Conexões" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,18"/>
                    <StackPanel x:Name="NetList"/>
                    <Button x:Name="NetSettingsButton" Style="{StaticResource PowerItem}" Height="56" FontSize="17" Margin="0,18,0,0"
                            Content="Configurações de rede do Windows" Click="OnNetSettingsClick"/>
                </StackPanel>
            </Border>
            <Border x:Name="NotifPanel" Visibility="Collapsed" Width="440" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,60,24,0"
                    Background="{DynamicResource T_F2171D26}" Padding="26" KeyboardNavigation.DirectionalNavigation="Contained">
                <StackPanel>
                    <TextBlock Text="Notificações" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,14"/>
                    <StackPanel x:Name="NotifActive" Visibility="Collapsed" Margin="0,0,0,14">
                        <TextBlock x:Name="NotifTitle" FontSize="17" TextWrapping="Wrap"/>
                        <ProgressBar x:Name="NotifBar" Height="6" Margin="0,10,0,8" Minimum="0" Maximum="1" Foreground="{DynamicResource Accent}" Background="#33FFFFFF" BorderThickness="0"/>
                        <TextBlock x:Name="NotifDetail" FontSize="14" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel x:Name="NotifGames" Visibility="Collapsed" Margin="0,0,0,14"/>
                    <StackPanel x:Name="NotifList"/>
                    <TextBlock x:Name="NotifEmpty" Text="Nada por aqui." FontSize="15" Foreground="{StaticResource TextMuted}" Margin="0,0,0,6"/>
                    <Button x:Name="NotifDetailsButton" Style="{StaticResource PowerItem}" Height="56" FontSize="17" Margin="0,14,0,0" Content="Mais detalhes (Downloads)" Click="OnNotifDetailsClick"/>
                    <Button x:Name="NotifCloseButton" Style="{StaticResource PowerItem}" Height="56" FontSize="17" Margin="0,8,0,0" Content="Limpar e fechar" Click="OnNotifClearClick"/>
                </StackPanel>
            </Border>
            <Border x:Name="VolPanel" Visibility="Collapsed" Width="400" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,60,24,0"
                    Background="{DynamicResource T_F2171D26}" Padding="26" KeyboardNavigation.DirectionalNavigation="Contained">
                <ScrollViewer VerticalScrollBarVisibility="Hidden" MaxHeight="760" Focusable="False">
                <StackPanel>
                    <TextBlock Text="Som" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,18"/>
                    <Button x:Name="MuteButton" Style="{StaticResource PowerItem}" Height="56" FontSize="17" Click="OnMuteClick"/>
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="VolDownButton" Style="{StaticResource SquareButton}" Width="56" Height="56" Click="OnVolDownClick"><TextBlock Text="&#xE738;" Style="{StaticResource Icon}"/></Button>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0">
                            <TextBlock x:Name="VolText" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <ProgressBar x:Name="VolBar" Minimum="0" Maximum="100" Height="8" Foreground="{DynamicResource Accent}" Background="{DynamicResource T_2B323C}" BorderThickness="0"/>
                        </StackPanel>
                        <Button x:Name="VolUpButton" Grid.Column="2" Style="{StaticResource SquareButton}" Width="56" Height="56" Click="OnVolUpClick"><TextBlock Text="&#xE710;" Style="{StaticResource Icon}"/></Button>
                    </Grid>

                    <TextBlock Text="Bluetooth" FontSize="22" FontWeight="SemiBold" Margin="0,26,0,14"/>
                    <Button x:Name="BtToggleButton" Style="{StaticResource PowerItem}" Height="56" FontSize="17" Content="Bluetooth" Click="OnBtToggleClick"/>
                    <Button x:Name="BtAddButton" Style="{StaticResource PowerItem}" Height="56" FontSize="17" Margin="4,10,4,4" Content="Adicionar fone de ouvido" Click="OnBtAddClick"/>
                    <StackPanel x:Name="BtPickPanel" Visibility="Collapsed" Margin="0,6,0,0">
                        <TextBlock x:Name="BtPickHint" FontSize="15" TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}" Margin="4,0,0,8"/>
                        <StackPanel x:Name="BtPickList"/>
                        <Button x:Name="BtPairButton" Style="{StaticResource PowerItem}" Height="52" FontSize="16" Margin="4,6,4,4" Content="Parear novo aparelho (Windows)" Click="OnBtPairClick"/>
                    </StackPanel>
                    <TextBlock x:Name="BtSavedTitle" Text="Fones salvos" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" Margin="4,16,0,8"/>
                    <StackPanel x:Name="BtSavedList"/>
                    <Button x:Name="BtAutoButton" Style="{StaticResource PowerItem}" Height="52" FontSize="16" Margin="4,10,4,4" Click="OnBtAutoClick"/>
                </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Side menu -->
        <Grid x:Name="MenuLayer" Visibility="Collapsed">
            <Rectangle x:Name="MenuScrim" Fill="{StaticResource Scrim}" MouseDown="OnScrimClick"/>
            <Border x:Name="MenuBox" Width="336" HorizontalAlignment="Left" Background="{DynamicResource T_111823}">
                <StackPanel x:Name="MenuList" Margin="0,269,0,0" KeyboardNavigation.DirectionalNavigation="Cycle">
                    <Button x:Name="MenuGameItem" Style="{StaticResource MenuItem}" Tag="Jogando" Visibility="Collapsed" Click="OnMenuGameClick">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="40" Height="40" Background="{DynamicResource T_1A2230}"><Image x:Name="MenuGameIcon" Stretch="UniformToFill"/></Border>
                            <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
                                <TextBlock x:Name="MenuGameName" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="230"/>
                                <TextBlock Text="JOGANDO AGORA" FontSize="11" FontWeight="Bold" Opacity="0.7"/>
                            </StackPanel>
                        </StackPanel></Button>
                    <Button Style="{StaticResource MenuItem}" Tag="Início" Click="OnMenuItemClick">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" Style="{StaticResource Icon}" Width="40"/><TextBlock Text="Início" FontSize="22"/></StackPanel></Button>
                    <Button Style="{StaticResource MenuItem}" Tag="Biblioteca" Click="OnMenuItemClick">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8F1;" Style="{StaticResource Icon}" Width="40"/><TextBlock Text="Biblioteca" FontSize="22"/></StackPanel></Button>
                    <Button Style="{StaticResource MenuItem}" Tag="Lojas" Click="OnMenuItemClick">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE719;" Style="{StaticResource Icon}" Width="40"/><TextBlock Text="Lojas" FontSize="22"/></StackPanel></Button>
                    <Button Style="{StaticResource MenuItem}" Tag="Mídias" Click="OnMenuItemClick">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE91B;" Style="{StaticResource Icon}" Width="40"/><TextBlock Text="Mídias" FontSize="22"/></StackPanel></Button>
                    <Button Style="{StaticResource MenuItem}" Tag="Downloads" Click="OnMenuItemClick">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE896;" Style="{StaticResource Icon}" Width="40"/><TextBlock Text="Downloads" FontSize="22"/></StackPanel></Button>
                    <Button Style="{StaticResource MenuItem}" Tag="Configurações" Click="OnMenuItemClick">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" Style="{StaticResource Icon}" Width="40"/><TextBlock Text="Configurações" FontSize="22"/></StackPanel></Button>
                    <Button Style="{StaticResource MenuItem}" Tag="Ligar/Desligar" Click="OnMenuItemClick">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7E8;" Style="{StaticResource Icon}" Width="40"/><TextBlock Text="Ligar/Desligar" FontSize="22"/></StackPanel></Button>
                </StackPanel>
            </Border>
            <!-- Beside the game entry: back to the game, or end it -->
            <Border x:Name="GameMenuPanel" Visibility="Collapsed" Width="400" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="336,269,0,0"
                    Background="{DynamicResource T_F2171D26}" KeyboardNavigation.DirectionalNavigation="Contained">
                <Grid>
                    <StackPanel x:Name="GameMenuMain">
                        <Button x:Name="ResumeGameButton" Style="{StaticResource PowerItem}" Content="Voltar ao jogo" Click="OnResumeGameClick"/>
                        <Border Height="3" Background="{DynamicResource T_0D1117}"/>
                        <Button x:Name="EndGameButton" Style="{StaticResource PowerItem}" Content="Encerrar jogo" Click="OnEndGameClick"/>
                    </StackPanel>
                    <StackPanel x:Name="GameMenuConfirm" Visibility="Collapsed" Margin="24,22,24,24">
                        <TextBlock x:Name="GameConfirmTitle" Text="Sair do jogo?" FontSize="24" FontWeight="SemiBold"/>
                        <TextBlock Text="Dados não salvos podem ser perdidos." FontSize="16" TextWrapping="Wrap" Foreground="{StaticResource TextSoft}" Margin="0,8,0,20"/>
                        <Button x:Name="EndConfirmButton" Style="{StaticResource PowerItem}" Height="56" Content="Confirmar" Click="OnEndGameConfirmClick"/>
                        <Button x:Name="EndCancelButton" Style="{StaticResource PowerItem}" Height="56" Content="Cancelar" Click="OnEndGameCancelClick"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <!-- Game options: rename and hide -->
        <Grid x:Name="OptionsPanel" Visibility="Collapsed">
            <Rectangle Fill="#E6000000" MouseDown="OnOptionsDimClick"/>
            <StackPanel Width="560" VerticalAlignment="Center" KeyboardNavigation.DirectionalNavigation="Contained">
                <TextBlock Text="OPÇÕES DO JOGO" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"/>
                <TextBlock x:Name="OptionsGameName" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,22" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="Nome no launcher" FontSize="15" Foreground="{StaticResource TextSoft}" Margin="0,0,0,6"/>
                <TextBox x:Name="OptionsNameBox" FontSize="18" Padding="10,8" MaxLength="80" Background="{DynamicResource Panel}" Foreground="White"
                         BorderBrush="{DynamicResource Focus}" CaretBrush="White"/>
                <Button x:Name="OptionsSaveNameButton" Style="{StaticResource PowerItem}" Height="56" FontSize="18" Margin="0,12,0,0" Content="Salvar nome" Click="OnOptionsSaveNameClick"/>
                <Button x:Name="OptionsResetNameButton" Style="{StaticResource PowerItem}" Height="56" FontSize="18" Content="Usar o nome original" Click="OnOptionsResetNameClick"/>
                <Border Height="3" Background="{DynamicResource T_0D1117}"/>
                <Button Style="{StaticResource PowerItem}" Height="56" FontSize="18" Content="Esconder este jogo da lista" Click="OnOptionsHideClick"/>
                <Border Height="3" Background="{DynamicResource T_0D1117}"/>
                <Button Style="{StaticResource PowerItem}" Height="56" FontSize="18" Content="Voltar" Click="OnOptionsBackClick"/>
            </StackPanel>
        </Grid>
        <!-- Apps tab: options of one app -->
        <Grid x:Name="AppMenuPanel" Visibility="Collapsed">
            <Rectangle Fill="#E6000000" MouseDown="OnAppMenuDimClick"/>
            <StackPanel Width="560" VerticalAlignment="Center" KeyboardNavigation.DirectionalNavigation="Contained">
                <TextBlock Text="APLICATIVO" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"/>
                <TextBlock x:Name="AppMenuName" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,22" TextTrimming="CharacterEllipsis"/>
                <Button x:Name="AppMenuLeft" Style="{StaticResource PowerItem}" Height="56" FontSize="18" Content="Mover para a esquerda" Click="OnAppMenuMoveLeft"/>
                <Button x:Name="AppMenuRight" Style="{StaticResource PowerItem}" Height="56" FontSize="18" Content="Mover para a direita" Click="OnAppMenuMoveRight"/>
                <Border Height="3" Background="{DynamicResource T_0D1117}"/>
                <Button x:Name="AppMenuRemove" Style="{StaticResource PowerItem}" Height="56" FontSize="18" Content="Remover da lista" Click="OnAppMenuRemove"/>
                <Border Height="3" Background="{DynamicResource T_0D1117}"/>
                <Button Style="{StaticResource PowerItem}" Height="56" FontSize="18" Content="Voltar" Click="OnAppMenuBack"/>
            </StackPanel>
        </Grid>
        <!-- Apps tab: add a program or a website -->
        <Grid x:Name="AppAddPanel" Visibility="Collapsed">
            <Rectangle Fill="#E6000000" MouseDown="OnAppAddDimClick"/>
            <StackPanel Width="560" VerticalAlignment="Center" KeyboardNavigation.DirectionalNavigation="Contained">
                <TextBlock Text="ADICIONAR À LISTA" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" Margin="0,0,0,22"/>
                <StackPanel x:Name="AppAddChoice">
                    <Button x:Name="AppAddProgramButton" Style="{StaticResource PowerItem}" Height="56" FontSize="18" Content="Programa (.exe ou atalho)..." Click="OnAppAddProgramClick"/>
                    <Button Style="{StaticResource PowerItem}" Height="56" FontSize="18" Content="Site (link)..." Click="OnAppAddSiteClick"/>
                    <Border Height="3" Background="{DynamicResource T_0D1117}"/>
                    <Button Style="{StaticResource PowerItem}" Height="56" FontSize="18" Content="Voltar" Click="OnAppAddBackClick"/>
                </StackPanel>
                <StackPanel x:Name="AppAddSite" Visibility="Collapsed">
                    <TextBlock Text="Endereço do site" FontSize="15" Foreground="{StaticResource TextSoft}" Margin="0,0,0,6"/>
                    <TextBox x:Name="AppAddUrlBox" FontSize="18" Padding="10,8" MaxLength="300" Background="{DynamicResource Panel}" Foreground="White"
                             BorderBrush="{DynamicResource Focus}" CaretBrush="White"/>
                    <TextBlock Text="Nome (opcional)" FontSize="15" Foreground="{StaticResource TextSoft}" Margin="0,14,0,6"/>
                    <TextBox x:Name="AppAddNameBox" FontSize="18" Padding="10,8" MaxLength="60" Background="{DynamicResource Panel}" Foreground="White"
                             BorderBrush="{DynamicResource Focus}" CaretBrush="White"/>
                    <Button x:Name="AppAddSaveButton" Style="{StaticResource PowerItem}" Height="56" FontSize="18" Margin="0,14,0,0" Content="Salvar" Click="OnAppAddSaveClick"/>
                    <Border Height="3" Background="{DynamicResource T_0D1117}"/>
                    <Button Style="{StaticResource PowerItem}" Height="56" FontSize="18" Content="Voltar" Click="OnAppAddBackClick"/>
                </StackPanel>
            </StackPanel>
        </Grid>
        <!-- Profile: photo and name -->
        <Grid x:Name="ProfilePanel" Visibility="Collapsed">
            <Rectangle Fill="#E6000000" MouseDown="OnProfileDimClick"/>
            <StackPanel Width="560" VerticalAlignment="Center" KeyboardNavigation.DirectionalNavigation="Contained">
                <TextBlock Text="PERFIL" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"/>
                <Border Width="132" Height="132" Margin="0,14,0,10" Background="{DynamicResource PanelRaised}" BorderBrush="{DynamicResource Focus}" BorderThickness="3">
                    <Grid>
                        <TextBlock Text="&#xE77B;" Style="{StaticResource Icon}" FontSize="64" Foreground="{StaticResource TextMuted}"/>
                        <Image x:Name="ProfileImage" Stretch="UniformToFill"/>
                    </Grid>
                </Border>
                <TextBlock x:Name="ProfileName" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="ProfileSub" FontSize="14" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" Margin="0,2,0,22"/>
                <Button x:Name="ProfilePhotoButton" Style="{StaticResource PowerItem}" Height="56" FontSize="18" Content="Alterar foto..." Click="OnProfilePhotoClick"/>
                <Button x:Name="ProfileSteamPhotoButton" Style="{StaticResource PowerItem}" Height="56" FontSize="18" Content="Usar a foto da Steam" Click="OnProfileSteamPhotoClick"/>
                <Button x:Name="ProfileRemovePhotoButton" Style="{StaticResource PowerItem}" Height="56" FontSize="18" Content="Remover foto" Click="OnProfileRemovePhotoClick"/>
                <Border Height="3" Background="{DynamicResource T_0D1117}"/>
                <TextBlock Text="Nome no launcher" FontSize="15" Foreground="{StaticResource TextSoft}" Margin="0,14,0,6"/>
                <TextBox x:Name="ProfileNameBox" FontSize="18" Padding="10,8" MaxLength="24" Background="{DynamicResource Panel}" Foreground="White"
                         BorderBrush="{DynamicResource Focus}" CaretBrush="White"/>
                <Button Style="{StaticResource PowerItem}" Height="56" FontSize="18" Margin="0,12,0,0" Content="Salvar nome" Click="OnProfileSaveNameClick"/>
                <Border Height="3" Background="{DynamicResource T_0D1117}"/>
                <Button x:Name="ProfileSwitchButton" Style="{StaticResource PowerItem}" Height="56" FontSize="18" Content="Trocar de conta Steam..." Click="OnProfileSwitchClick"/>
                <Border Height="3" Background="{DynamicResource T_0D1117}"/>
                <Button Style="{StaticResource PowerItem}" Height="56" FontSize="18" Content="Voltar" Click="OnProfileBackClick"/>
            </StackPanel>
        </Grid>
        <!-- Which Steam account to use: shown when the launcher opens (depending on the setting) and from the profile photo -->
        <Grid x:Name="AccountPanel" Visibility="Collapsed" Background="{DynamicResource T_FF05080C}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" KeyboardNavigation.DirectionalNavigation="Contained">
                <TextBlock Text="QUEM ESTÁ JOGANDO?" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"/>
                <TextBlock x:Name="AccountSub" Text="Escolha a conta Steam. Todos os jogos instalados no PC aparecem em qualquer conta." FontSize="17" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" Margin="0,8,0,34"/>
                <StackPanel x:Name="AccountList" Orientation="Horizontal" HorizontalAlignment="Center"/>
                <TextBlock x:Name="AccountHint" Text="B: continuar com a conta atual" FontSize="14" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" Margin="0,34,0,0"/>
            </StackPanel>
        </Grid>
        <!-- The launcher's own on-screen keyboard (Y opens it, B closes it) -->
        <Border x:Name="OskPanel" Visibility="Collapsed" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,76"
                Background="{DynamicResource T_171D26}" BorderBrush="{DynamicResource T_3A4556}" BorderThickness="1" CornerRadius="16" Padding="22,16,22,14">
            <StackPanel KeyboardNavigation.DirectionalNavigation="Contained" KeyboardNavigation.TabNavigation="Contained">
                <Border Background="{DynamicResource T_0D1117}" CornerRadius="8" Padding="16,10" Margin="4,0,4,10">
                    <TextBlock x:Name="OskText" FontSize="22" Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis" MinHeight="30"/>
                </Border>
                <StackPanel x:Name="OskRows"/>
            </StackPanel>
        </Border>
        <!-- Entering a game: art, logo, animated controller -->
        <Grid x:Name="LaunchOverlay" Visibility="Collapsed" Background="{DynamicResource T_FF05080C}" KeyboardNavigation.DirectionalNavigation="Contained" KeyboardNavigation.TabNavigation="Contained">
            <Image x:Name="LaunchBackdrop" Stretch="UniformToFill" Opacity="0.5" RenderTransformOrigin="0.5,0.5"/>
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#99000000" Offset="0"/>
                        <GradientStop Color="#55000000" Offset="0.45"/>
                        <GradientStop Color="#EE000000" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <StackPanel x:Name="LaunchContent" VerticalAlignment="Center" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                <Grid Width="760" Height="200">
                    <Image x:Name="LaunchLogo" Stretch="Uniform"/>
                    <TextBlock x:Name="LaunchTitle" FontSize="48" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                    <Canvas x:Name="LaunchSpinner" Width="26" Height="26" RenderTransformOrigin="0.5,0.5">
                        <Path Data="M 13,3 A 10,10 0 1 1 3,13" Stroke="White" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Canvas>
                    <TextBlock x:Name="LaunchStatus" Text="Iniciando…" FontSize="22" Foreground="{StaticResource TextSoft}" Margin="14,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <Viewbox Width="300" Height="213" Margin="0,34,0,0">
                    <Canvas Width="240" Height="170">
                        <Border Canvas.Left="44" Canvas.Top="10" Width="46" Height="13" CornerRadius="6" Background="{DynamicResource T_2A3442}" BorderBrush="{DynamicResource T_6B7889}" BorderThickness="2"/>
                        <Border x:Name="PadLBGlow" Canvas.Left="44" Canvas.Top="10" Width="46" Height="13" CornerRadius="6" Background="White" Opacity="0"/>
                        <Border Canvas.Left="150" Canvas.Top="10" Width="46" Height="13" CornerRadius="6" Background="{DynamicResource T_2A3442}" BorderBrush="{DynamicResource T_6B7889}" BorderThickness="2"/>
                        <Border x:Name="PadRBGlow" Canvas.Left="150" Canvas.Top="10" Width="46" Height="13" CornerRadius="6" Background="White" Opacity="0"/>
                        <Path Fill="{DynamicResource T_1B2330}" Stroke="{DynamicResource T_6B7889}" StrokeThickness="3" StrokeLineJoin="Round"
                              Data="M 66,28 L 174,28 C 200,28 214,48 224,92 C 232,128 234,154 220,160 C 208,165 198,152 190,138 C 184,128 178,122 166,122 L 74,122 C 62,122 56,128 50,138 C 42,152 32,165 20,160 C 6,154 8,128 16,92 C 26,48 40,28 66,28 Z"/>
                        <Ellipse Canvas.Left="48" Canvas.Top="40" Width="36" Height="36" Fill="{DynamicResource T_161C27}" Stroke="{DynamicResource T_6B7889}" StrokeThickness="2"/>
                        <Ellipse x:Name="PadStickL" Canvas.Left="55" Canvas.Top="47" Width="22" Height="22" Fill="{DynamicResource T_3A4556}"/>
                        <Ellipse Canvas.Left="128" Canvas.Top="82" Width="36" Height="36" Fill="{DynamicResource T_161C27}" Stroke="{DynamicResource T_6B7889}" StrokeThickness="2"/>
                        <Ellipse x:Name="PadStickR" Canvas.Left="135" Canvas.Top="89" Width="22" Height="22" Fill="{DynamicResource T_3A4556}"/>
                        <Path Fill="{DynamicResource T_2A3442}" Stroke="{DynamicResource T_6B7889}" StrokeThickness="2" StrokeLineJoin="Round"
                              Data="M 90,86 L 102,86 L 102,94 L 110,94 L 110,106 L 102,106 L 102,114 L 90,114 L 90,106 L 82,106 L 82,94 L 90,94 Z"/>
                        <Path x:Name="PadDpadGlow" Fill="White" Opacity="0" StrokeLineJoin="Round"
                              Data="M 90,86 L 102,86 L 102,94 L 110,94 L 110,106 L 102,106 L 102,114 L 90,114 L 90,106 L 82,106 L 82,94 L 90,94 Z"/>
                        <Ellipse Canvas.Left="113" Canvas.Top="33" Width="14" Height="14" Fill="{DynamicResource T_2A3442}" Stroke="{DynamicResource T_6B7889}" StrokeThickness="2"/>
                        <Border Canvas.Left="99" Canvas.Top="53" Width="11" Height="11" CornerRadius="3" Background="{DynamicResource T_2A3442}" BorderBrush="{DynamicResource T_6B7889}" BorderThickness="1.5"/>
                        <Border x:Name="PadSelectGlow" Canvas.Left="99" Canvas.Top="53" Width="11" Height="11" CornerRadius="3" Background="White" Opacity="0"/>
                        <Border Canvas.Left="131" Canvas.Top="53" Width="11" Height="11" CornerRadius="3" Background="{DynamicResource T_2A3442}" BorderBrush="{DynamicResource T_6B7889}" BorderThickness="1.5"/>
                            <Grid x:Name="PadA" Canvas.Left="166" Canvas.Top="66" Width="20" Height="20" RenderTransformOrigin="0.5,0.5">
                                <Ellipse Fill="{DynamicResource T_2A3442}" Stroke="{DynamicResource T_6B7889}" StrokeThickness="2"/>
                                <Ellipse x:Name="PadAGlow" Fill="#4CA82E" Opacity="0"/>
                                <TextBlock Text="A" FontSize="11" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid x:Name="PadB" Canvas.Left="182" Canvas.Top="50" Width="20" Height="20" RenderTransformOrigin="0.5,0.5">
                                <Ellipse Fill="{DynamicResource T_2A3442}" Stroke="{DynamicResource T_6B7889}" StrokeThickness="2"/>
                                <Ellipse x:Name="PadBGlow" Fill="#C9302C" Opacity="0"/>
                                <TextBlock Text="B" FontSize="11" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid x:Name="PadX" Canvas.Left="150" Canvas.Top="50" Width="20" Height="20" RenderTransformOrigin="0.5,0.5">
                                <Ellipse Fill="{DynamicResource T_2A3442}" Stroke="{DynamicResource T_6B7889}" StrokeThickness="2"/>
                                <Ellipse x:Name="PadXGlow" Fill="#2F7BFF" Opacity="0"/>
                                <TextBlock Text="X" FontSize="11" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid x:Name="PadY" Canvas.Left="166" Canvas.Top="34" Width="20" Height="20" RenderTransformOrigin="0.5,0.5">
                                <Ellipse Fill="{DynamicResource T_2A3442}" Stroke="{DynamicResource T_6B7889}" StrokeThickness="2"/>
                                <Ellipse x:Name="PadYGlow" Fill="#E8B923" Opacity="0"/>
                                <TextBlock Text="Y" FontSize="11" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                    </Canvas>
                </Viewbox>
                <TextBlock Text="Durante o jogo, segure Select + B por 2 segundos para abrir o menu" FontSize="15" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" Margin="0,22,0,0"/>
            </StackPanel>
            <Button x:Name="LaunchCancelButton" Style="{StaticResource PowerItem}" Width="220" Height="52" FontSize="18" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                    Margin="44,0,0,84" Content="Cancelar" Click="OnLaunchCancelClick"/>
        </Grid>
        <!-- Media viewer: a photo or a video from the captures folder, view only -->
        <Grid x:Name="MediaViewer" Visibility="Collapsed" Background="#FF000000" Focusable="True" FocusVisualStyle="{x:Null}">
            <Image x:Name="ViewerImage" Stretch="Uniform"/>
            <MediaElement x:Name="ViewerVideo" LoadedBehavior="Manual" UnloadedBehavior="Manual" Stretch="Uniform" Visibility="Collapsed" Volume="0.8"
                          MediaOpened="OnViewerVideoOpened" MediaEnded="OnViewerVideoEnded" MediaFailed="OnViewerVideoFailed"/>
            <TextBlock x:Name="ViewerMessage" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="30" FontWeight="SemiBold" Foreground="White"
                       TextAlignment="Center" TextWrapping="Wrap" MaxWidth="900" Visibility="Collapsed"/>
            <Border x:Name="ViewerBar" VerticalAlignment="Bottom" Padding="54,48,54,26">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00000000" Offset="0"/>
                        <GradientStop Color="#E6000000" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel>
                    <Grid>
                        <TextBlock x:Name="ViewerTitle" FontSize="22" FontWeight="SemiBold" Foreground="White"/>
                        <TextBlock x:Name="ViewerCounter" HorizontalAlignment="Right" FontSize="16" Foreground="#B8C0CC"/>
                    </Grid>
                    <Grid x:Name="ViewerTimeline" Margin="0,14,0,0" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ViewerTime" Foreground="White" FontSize="15" MinWidth="52"/>
                        <Grid x:Name="ViewerTrack" Grid.Column="1" Margin="16,0" Height="6" VerticalAlignment="Center">
                            <Border Background="#44FFFFFF" CornerRadius="3"/>
                            <Border x:Name="ViewerFill" Background="{DynamicResource Accent}" CornerRadius="3" HorizontalAlignment="Left" Width="0"/>
                        </Grid>
                        <TextBlock x:Name="ViewerDuration" Grid.Column="2" Foreground="#B8C0CC" FontSize="15" MinWidth="52" TextAlignment="Right"/>
                    </Grid>
                    <TextBlock x:Name="ViewerHelp" FontSize="14" Foreground="#B8C0CC" Margin="0,14,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Power menu -->
        <Grid x:Name="PowerPanel" Visibility="Collapsed">
            <Rectangle Fill="#E6000000" MouseDown="OnPowerDimClick"/>
            <StackPanel Width="398" VerticalAlignment="Center" KeyboardNavigation.DirectionalNavigation="Contained">
                <TextBlock x:Name="PowerTitle" Text="Ligar/Desligar" FontSize="26" HorizontalAlignment="Center" Margin="0,0,0,26"/>
                <StackPanel x:Name="PowerMain">
                    <Button x:Name="PowerSleepButton" Style="{StaticResource PowerItem}" Tag="Sleep" Content="Suspender sistema" Click="OnPowerChoiceClick"/>
                    <Button Style="{StaticResource PowerItem}" Tag="ShutDown" Content="Desligar sistema" Click="OnPowerChoiceClick"/>
                    <Button Style="{StaticResource PowerItem}" Tag="Restart" Content="Reiniciar sistema" Click="OnPowerChoiceClick"/>
                    <Border Height="3" Background="{DynamicResource T_0D1117}"/>
                    <Button Style="{StaticResource PowerItem}" Tag="LogOff" Content="Finalizar sessão do Windows" Click="OnPowerChoiceClick"/>
                    <Border Height="3" Background="{DynamicResource T_0D1117}"/>
                    <Button Style="{StaticResource PowerItem}" Tag="Minimize" Content="Minimizar o launcher" Click="OnPowerChoiceClick"/>
                    <Button Style="{StaticResource PowerItem}" Tag="Exit" Content="Sair do launcher" Click="OnPowerChoiceClick"/>
                    <Border Height="3" Background="{DynamicResource T_0D1117}"/>
                    <Button Style="{StaticResource PowerItem}" Content="Cancelar" Click="OnPowerCancelClick"/>
                </StackPanel>
                <StackPanel x:Name="PowerConfirm" Visibility="Collapsed">
                    <TextBlock x:Name="PowerConfirmText" TextWrapping="Wrap" FontSize="16" TextAlignment="Center" Foreground="{StaticResource TextSoft}" Margin="0,0,0,22"
                               Text="Jogos e aplicativos abertos serão fechados. O progresso não salvo pode ser perdido."/>
                    <Button x:Name="PowerCancelButton" Style="{StaticResource PowerItem}" Content="Cancelar" Click="OnPowerCancelClick"/>
                    <Button x:Name="PowerConfirmButton" Style="{StaticResource PowerItem}" Content="Confirmar" Click="OnPowerConfirmClick"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Window>

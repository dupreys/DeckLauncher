<Window x:Class="DeckLauncher.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeckLauncher" Icon="Assets/app.ico" Width="1280" Height="720" Background="{DynamicResource Bg}" Foreground="{StaticResource Text}"
        WindowState="Maximized" WindowStyle="None" KeyDown="OnKeyDown" Loaded="OnLoaded" Activated="OnActivated" Deactivated="OnDeactivated">
    <Grid x:Name="RootGrid">
        <!-- Big background picture of the focused game (filled in step 2) + fade into the page colour -->
        <Grid x:Name="HeroLayer" RenderTransformOrigin="0.5,0.4">
            <Image x:Name="HeroImagePrev" Stretch="UniformToFill" VerticalAlignment="Top" HorizontalAlignment="Center" Opacity="0"/>
            <Image x:Name="HeroImage" Stretch="UniformToFill" VerticalAlignment="Top" HorizontalAlignment="Center"/>
        </Grid>
        <!-- Under the cards the wallpaper is blurred and dimmed (like the Steam Big Picture) so the texts there stay readable -->
        <Grid x:Name="HeroBlurLayer" IsHitTestVisible="False" Visibility="Collapsed">
            <Grid.Effect><BlurEffect Radius="12" KernelType="Gaussian" RenderingBias="Performance"/></Grid.Effect>
            <Grid.OpacityMask>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#00000000" Offset="0.74"/>
                    <GradientStop Color="#FF000000" Offset="0.86"/>
                </LinearGradientBrush>
            </Grid.OpacityMask>
            <!-- Same slow zoom and drift as the sharp wallpaper (the transform is shared in StartHeroDrift) -->
            <Grid x:Name="HeroBlurInner" RenderTransformOrigin="0.5,0.4">
                <Image x:Name="HeroBlurPrev" Stretch="UniformToFill" VerticalAlignment="Top" HorizontalAlignment="Center" Opacity="0"/>
                <Image x:Name="HeroBlurImage" Stretch="UniformToFill" VerticalAlignment="Top" HorizontalAlignment="Center"/>
            </Grid>
        </Grid>
        <!-- A light, even dimming of the whole wallpaper on the home -->
        <Rectangle x:Name="HeroDim" Fill="Black" Opacity="0" IsHitTestVisible="False"/>
        <Rectangle x:Name="HeroShade">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#00000000" Offset="0.0"/>
                    <GradientStop Color="{DynamicResource C_400D131A}" Offset="0.35"/>
                    <GradientStop Color="{DynamicResource C_F00D131A}" Offset="0.62"/>
                    <GradientStop Color="{DynamicResource C_FF0D131A}" Offset="0.8"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Pages -->
        <Grid x:Name="HomePage" Margin="0,0,0,56">
        <!-- Style "Clássico" (the original home) -->
        <Grid x:Name="ClassicHome">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="96"/>
            </Grid.RowDefinitions>
            <!-- Ambient light under the focused game, tinted with the colours of its art; slides along with the row -->
            <Ellipse x:Name="RecentGlow" Grid.Row="1" Grid.RowSpan="2" Width="820" Height="240" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                     Margin="0,0,0,-50" Visibility="Collapsed" IsHitTestVisible="False">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop x:Name="GlowCore" Color="#4C1A9FFF" Offset="0"/>
                        <GradientStop x:Name="GlowEdge" Color="#001A9FFF" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.RenderTransform><TranslateTransform x:Name="GlowMove"/></Ellipse.RenderTransform>
            </Ellipse>
            <StackPanel Grid.Row="1" Margin="18,0,0,0">
                <TextBlock x:Name="RecentTitle" Text="Jogos recentes" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextSoft}" Margin="28,0,0,4"/>
                <TextBlock x:Name="EmptyText" Visibility="Collapsed" FontSize="17" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" MaxWidth="760" HorizontalAlignment="Left" Margin="0,0,0,40"/>
                <ScrollViewer x:Name="RecentScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel x:Name="RecentHost" Orientation="Horizontal" Margin="28,12,0,12" RequestBringIntoView="OnRecentBringIntoView">
                    <ItemsControl x:Name="RecentRow">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource GameTile}" Click="OnTileClick" GotKeyboardFocus="OnHomeTileFocus" Loaded="OnTileLoaded">
                                    <Grid>
                                        <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center"
                                                   VerticalAlignment="Center" Margin="16"/>
                                        <Image Source="{Binding Cover}" Stretch="UniformToFill" Style="{StaticResource ShowWhenNotFeatured}"/>
                                        <Image Source="{Binding Wide}" Stretch="UniformToFill" Style="{StaticResource ShowWhenFeatured}"/>
                                        <Image Source="{Binding Logo}" Stretch="Uniform" MaxWidth="330" MaxHeight="130" HorizontalAlignment="Left"
                                               VerticalAlignment="Bottom" Margin="22" Style="{StaticResource ShowWhenFeatured}"/>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                
                    <Button x:Name="MoreTile" Style="{StaticResource MoreTile}" Click="OnMoreTileClick" Content="Veja mais na sua biblioteca"/>
                    </StackPanel>
                </ScrollViewer>
            </StackPanel>
            <!-- Name and recent play time under the focused game; slides along with the row -->
            <StackPanel x:Name="RecentCaption" Grid.Row="2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,0,0,0" Visibility="Collapsed" IsHitTestVisible="False">
                <StackPanel.RenderTransform><TranslateTransform x:Name="CaptionMove"/></StackPanel.RenderTransform>
                <TextBlock x:Name="CaptionTitle" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis" MaxWidth="560"/>
                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                    <TextBlock Text="&#x25B6;" FontSize="10" Foreground="#5BB52F" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="CaptionSub" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSoft}"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,14">
                <Button Style="{StaticResource TabText}" Content="NOVIDADES" Tag="news" Click="OnHomeTabClick"/>
                <Ellipse Width="9" Height="9" Fill="{DynamicResource Accent}" Margin="-8,0,10,0"/>
                <Button Style="{StaticResource TabText}" Content="AMIGOS" Tag="friends" Click="OnHomeTabClick"/>
                <Button Style="{StaticResource TabText}" Content="RECOMENDADOS" Tag="recs" Click="OnHomeTabClick"/>
            </StackPanel>
        </Grid>

        <!-- Style "Painel": featured game, grid of recent games and info tiles -->
        <Grid x:Name="PanelHome" Visibility="Collapsed" Margin="64,70,64,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="PanelEmpty" Visibility="Collapsed" FontSize="17" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" MaxWidth="760"
                       HorizontalAlignment="Left" VerticalAlignment="Top"/>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="PanelFeatured" Style="{StaticResource PanelTile}" Margin="0,0,16,16" Click="OnTileClick" GotKeyboardFocus="OnHomeTileFocus" Loaded="OnTileLoaded">
                    <Button.Background>
                        <ImageBrush ImageSource="{Binding Wide}" Stretch="UniformToFill"/>
                    </Button.Background>
                    <Grid>
                        <Border CornerRadius="13" IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00000000" Offset="0.35"/>
                                    <GradientStop Color="#E6000000" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="28,0,28,26">
                            <Image Source="{Binding Logo}" Stretch="Uniform" MaxWidth="340" MaxHeight="110" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding Name}" FontSize="32" FontWeight="Bold" TextTrimming="CharacterEllipsis" Foreground="{StaticResource Text}"/>
                            <TextBlock Text="{Binding RecentText}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextSoft}" Margin="0,2,0,14"/>
                            <Border Background="{StaticResource PlayGreen}" CornerRadius="22" Padding="26,9" HorizontalAlignment="Left">
                                <TextBlock Text="&#x25B6;  Jogar" FontSize="17" FontWeight="Bold" Foreground="White"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Button>
                <ItemsControl x:Name="PanelGrid" Grid.Column="1">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Columns="3" Rows="2"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource PanelTile}" Click="OnTileClick" GotKeyboardFocus="OnHomeTileFocus" Loaded="OnTileLoaded">
                                <Button.Background>
                                    <ImageBrush ImageSource="{Binding Cover}" Stretch="UniformToFill"/>
                                </Button.Background>
                                <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center"
                                           VerticalAlignment="Center" Margin="12" Style="{StaticResource ShowWhenNoCover}"/>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
            <UniformGrid Grid.Row="1" Rows="1" Columns="5" Margin="0,4,0,0">
                <Button x:Name="PanelInfoLibrary" Style="{StaticResource InfoTile}" Tag="Biblioteca" Click="OnHomeShortcutClick">
                    <StackPanel><TextBlock Text="Biblioteca" FontSize="20" FontWeight="Bold"/><TextBlock x:Name="PanelInfoLibraryText" FontSize="13" Foreground="{StaticResource TextMuted}" Margin="0,3,0,0"/></StackPanel>
                </Button>
                <Button x:Name="PanelInfoDownloads" Style="{StaticResource InfoTile}" Tag="Downloads" Click="OnHomeShortcutClick">
                    <StackPanel><TextBlock Text="Downloads" FontSize="20" FontWeight="Bold"/><TextBlock x:Name="PanelInfoDownloadsText" FontSize="13" Foreground="{StaticResource TextMuted}" Margin="0,3,0,0"/></StackPanel>
                </Button>
                <Button Style="{StaticResource InfoTile}" Tag="Aplicativos" Click="OnHomeShortcutClick">
                    <StackPanel><TextBlock Text="Aplicativos" FontSize="20" FontWeight="Bold"/><TextBlock Text="Programas e atalhos" FontSize="13" Foreground="{StaticResource TextMuted}" Margin="0,3,0,0"/></StackPanel>
                </Button>
                <Button x:Name="PanelInfoFriends" Style="{StaticResource InfoTile}" Tag="Amigos" Click="OnHomeShortcutClick">
                    <StackPanel><TextBlock Text="Amigos" FontSize="20" FontWeight="Bold"/><TextBlock x:Name="PanelInfoFriendsText" FontSize="13" Foreground="{StaticResource TextMuted}" Margin="0,3,0,0"/></StackPanel>
                </Button>
                <Button Style="{StaticResource InfoTile}" Tag="Mídias" Margin="0" Click="OnHomeShortcutClick">
                    <StackPanel><TextBlock Text="Capturas" FontSize="20" FontWeight="Bold"/><TextBlock Text="Imagens dos seus jogos" FontSize="13" Foreground="{StaticResource TextMuted}" Margin="0,3,0,0"/></StackPanel>
                </Button>
            </UniformGrid>
        </Grid>

        <!-- Style "Cinema": the game in big letters with its art behind and the recent games in a strip -->
        <Grid x:Name="CinemaHome" Visibility="Collapsed" Margin="0,0,0,0">
            <Rectangle IsHitTestVisible="False">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#EB060A12" Offset="0"/>
                        <GradientStop Color="#8C060A12" Offset="0.4"/>
                        <GradientStop Color="#00060A12" Offset="0.75"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle IsHitTestVisible="False" VerticalAlignment="Bottom" Height="520">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                        <GradientStop Color="#F2060A12" Offset="0"/>
                        <GradientStop Color="#00060A12" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <StackPanel Margin="84,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" MaxWidth="900">
                <TextBlock x:Name="CinemaCaption" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Accent}" Margin="0,0,0,14"/>
                <Image x:Name="CinemaLogo" Stretch="Uniform" MaxWidth="560" MaxHeight="170" HorizontalAlignment="Left" Visibility="Collapsed"/>
                <TextBlock x:Name="CinemaTitle" FontSize="84" FontWeight="Black" TextWrapping="Wrap" LineHeight="84" Foreground="White"/>
                <TextBlock x:Name="CinemaMeta" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextSoft}" Margin="0,16,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,30,0,0">
                    <Button x:Name="CinemaPlay" Style="{StaticResource RoomChip}" Margin="0,0,12,0" Content="&#x25B6;  Jogar" Click="OnCinemaPlayClick"/>
                    <Button Style="{StaticResource RoomChip}" Margin="0,0,12,0" Content="Biblioteca" Tag="Biblioteca" Click="OnHomeShortcutClick"/>
                    <Button Style="{StaticResource RoomChip}" Margin="0,0,12,0" Content="Aplicativos" Tag="Aplicativos" Click="OnHomeShortcutClick"/>
                    <Button Style="{StaticResource RoomChip}" Margin="0,0,12,0" Content="Amigos" Tag="Amigos" Click="OnHomeShortcutClick"/>
                </StackPanel>
            </StackPanel>
            <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Margin="84,0,0,30">
                <TextBlock Text="Jogos recentes" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextSoft}" Margin="0,0,0,14"/>
                <TextBlock x:Name="CinemaEmpty" Visibility="Collapsed" FontSize="17" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" MaxWidth="760"/>
                <ScrollViewer x:Name="CinemaScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Focusable="False"
                              Margin="-16,0,0,0">
                <!-- The margin is room for the selection frame and its growth: the viewport clips whatever goes past it. -->
                <ItemsControl x:Name="CinemaRow" Margin="16,12,16,12" RequestBringIntoView="OnCinemaBringIntoView">
                    <ItemsControl.RenderTransform><TranslateTransform x:Name="CinemaShift"/></ItemsControl.RenderTransform>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource CinemaTile}" Click="OnTileClick" GotKeyboardFocus="OnCinemaTileFocus" Loaded="OnTileLoaded">
                                <Button.Background>
                                    <ImageBrush ImageSource="{Binding Cover}" Stretch="UniformToFill"/>
                                </Button.Background>
                                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center"
                                           VerticalAlignment="Center" Margin="12" Style="{StaticResource ShowWhenNoCover}"/>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Grid>

        <!-- Style "Carrossel": one big poster in the middle, the others on its sides -->
        <Grid x:Name="CarouselHome" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Rectangle Grid.RowSpan="3" IsHitTestVisible="False">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                        <GradientStop Color="#D9060A12" Offset="0"/>
                        <GradientStop Color="#40060A12" Offset="0.55"/>
                        <GradientStop Color="#8C060A12" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <StackPanel Margin="84,84,0,0" HorizontalAlignment="Left">
                <TextBlock x:Name="CarouselClock" FontSize="88" FontWeight="Light" Foreground="White"/>
                <TextBlock x:Name="CarouselDate" FontSize="22" Foreground="{StaticResource TextSoft}"/>
            </StackPanel>
            <TextBlock x:Name="CarouselEmpty" Grid.Row="1" Visibility="Collapsed" FontSize="17" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" MaxWidth="760"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Grid x:Name="CarouselView" Grid.Row="1" ClipToBounds="False" Margin="0,40,0,10">
                <!-- A Canvas gives the row all the width it wants: in a plain Grid cell it was cut at the width of the screen. -->
                <Canvas ClipToBounds="False">
                <ItemsControl x:Name="CarouselRow" Canvas.Left="0" Canvas.Bottom="0">
                    <ItemsControl.RenderTransform><TranslateTransform x:Name="CarouselShift"/></ItemsControl.RenderTransform>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource CarouselTile}" Click="OnTileClick" GotKeyboardFocus="OnCarouselTileFocus" Loaded="OnTileLoaded">
                                <Button.Background>
                                    <ImageBrush ImageSource="{Binding Cover}" Stretch="UniformToFill"/>
                                </Button.Background>
                                <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center"
                                           VerticalAlignment="Center" Margin="14" Style="{StaticResource ShowWhenNoCover}"/>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </Canvas>
            </Grid>
            <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,6,0,34">
                <TextBlock x:Name="CarouselName" FontSize="46" FontWeight="ExtraBold" Foreground="White" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="1200"/>
                <TextBlock x:Name="CarouselSub" FontSize="18" Foreground="{StaticResource TextSoft}" HorizontalAlignment="Center" Margin="0,6,0,14"/>
                <StackPanel x:Name="CarouselDots" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,18"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Style="{StaticResource RoomChip}" Content="Biblioteca" Tag="Biblioteca" Click="OnHomeShortcutClick"/>
                    <Button Style="{StaticResource RoomChip}" Content="Aplicativos" Tag="Aplicativos" Click="OnHomeShortcutClick"/>
                    <Button Style="{StaticResource RoomChip}" Content="Downloads" Tag="Downloads" Click="OnHomeShortcutClick"/>
                    <Button Style="{StaticResource RoomChip}" Content="Amigos" Tag="Amigos" Click="OnHomeShortcutClick"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Style "Sala (OLED)": pure black, big clock, a row of game icons and shortcut chips -->
        <Grid x:Name="RoomHome" Visibility="Collapsed" Margin="0,0,0,-56">
            <Grid.Background>
                <RadialGradientBrush Center="0.5,0.95" GradientOrigin="0.5,0.95" RadiusX="0.7" RadiusY="0.55">
                    <GradientStop Color="#33142B55" Offset="0"/>
                    <GradientStop Color="#FF000000" Offset="1"/>
                </RadialGradientBrush>
            </Grid.Background>
            <TextBlock x:Name="RoomStatus" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,76,64,0" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}"/>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,40,0,56">
                <TextBlock x:Name="RoomGreeting" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource TextSoft}" HorizontalAlignment="Center"/>
                <TextBlock x:Name="RoomClock" FontSize="124" FontWeight="ExtraLight" Foreground="White" HorizontalAlignment="Center" Margin="0,-6,0,22"/>
                <TextBlock x:Name="RoomEmpty" Visibility="Collapsed" FontSize="17" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" MaxWidth="640" TextAlignment="Center" Margin="0,0,0,24"/>
                <ItemsControl x:Name="RoomRow" HorizontalAlignment="Center" Margin="0,14,0,18">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource RoomIcon}" Click="OnTileClick" GotKeyboardFocus="OnRoomTileFocus" Loaded="OnTileLoaded">
                                <Button.Background>
                                    <ImageBrush ImageSource="{Binding Cover}" Stretch="UniformToFill"/>
                                </Button.Background>
                                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center"
                                           VerticalAlignment="Center" Margin="12" Style="{StaticResource ShowWhenNoCover}"/>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="RoomName" FontSize="40" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="1100" Margin="0,12,0,0"/>
                <TextBlock x:Name="RoomSub" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" Margin="0,4,0,26"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="RoomNowPlaying" Style="{StaticResource RoomChip}" Visibility="Collapsed" Click="OnRoomNowPlayingClick"/>
                    <Button Style="{StaticResource RoomChip}" Content="Biblioteca" Tag="Biblioteca" Click="OnHomeShortcutClick"/>
                    <Button Style="{StaticResource RoomChip}" Content="Lojas" Tag="Lojas" Click="OnHomeShortcutClick"/>
                    <Button Style="{StaticResource RoomChip}" Content="Aplicativos" Tag="Aplicativos" Click="OnHomeShortcutClick"/>
                    <Button Style="{StaticResource RoomChip}" Content="Downloads" Tag="Downloads" Click="OnHomeShortcutClick"/>
                    <Button Style="{StaticResource RoomChip}" Content="Amigos" Tag="Amigos" Click="OnHomeShortcutClick"/>
                </StackPanel>
            </StackPanel>
        </Grid>
        </Grid>

        <Grid x:Name="LibraryPage" Margin="0,56,0,56" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel x:Name="TabsPanel" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,26"/>
            <ScrollViewer x:Name="LibScroll" Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Focusable="False" SizeChanged="OnLibScrollSizeChanged">
                <Grid x:Name="LibContent">
                <ItemsControl x:Name="LibGrid" Margin="0,28,0,60" HorizontalAlignment="Center" LostKeyboardFocus="OnLibGridLostFocus">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Click="OnTileClick" Loaded="OnTileLoaded" GotKeyboardFocus="OnLibTileFocus">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource LibTile}">
                                        <Style.Triggers>
                                            <!-- Games that are owned but not installed: dimmed, a little clearer under the selector -->
                                            <DataTrigger Binding="{Binding IsNotInstalled}" Value="True">
                                                <Setter Property="Opacity" Value="0.4"/>
                                            </DataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsNotInstalled}" Value="True"/>
                                                    <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsKeyboardFocused}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Opacity" Value="0.85"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Grid>
                                    <TextBlock Text="{Binding Name}" FontSize="19" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center"
                                               VerticalAlignment="Center" Margin="16"/>
                                    <Image Source="{Binding Cover}" Stretch="UniformToFill"/>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Canvas IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Border x:Name="LibCursor" Visibility="Collapsed" BorderBrush="{StaticResource Text}" BorderThickness="3" IsHitTestVisible="False"/>
                </Canvas>
                </Grid>
            </ScrollViewer>
            <ScrollViewer x:Name="AppsScroll" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <StackPanel Margin="0,28,0,60">
                    <WrapPanel x:Name="AppsPanel" HorizontalAlignment="Center"/>
                    <TextBlock Text="X ou botão direito do mouse: opções do aplicativo (mover, ocultar, remover)" FontSize="13"
                               Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
            </ScrollViewer>
            <TextBlock x:Name="LibEmpty" Grid.Row="1" Visibility="Collapsed" Text="Nenhum jogo nesta lista." FontSize="17"
                       Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" Margin="0,60,0,0"/>
        </Grid>

        <Grid x:Name="GamePage" Visibility="Collapsed" Margin="0,0,0,56">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="180"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Image Source="{Binding Logo}" Stretch="Uniform" MaxWidth="620" MaxHeight="250" HorizontalAlignment="Left"
                       VerticalAlignment="Bottom" Margin="46,0,0,34"/>
                <TextBlock Text="{Binding Name}" FontSize="56" FontWeight="Black" TextWrapping="Wrap" MaxWidth="1100" HorizontalAlignment="Left"
                           VerticalAlignment="Bottom" Margin="46,0,0,34">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Logo}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
